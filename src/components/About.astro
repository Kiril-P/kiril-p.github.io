---
import { BookOpen, Briefcase, Dumbbell, GraduationCap, Music, Target, Trophy } from 'lucide-react';

const currentWork = [
  {
    company: 'naiss ride',
    role: 'Mobile Software Engineer',
    period: 'June 2026 - Present',
    summary: 'Shipping React Native / Expo features for a live social-carpooling app (4.6/5 on the App Store): a rewards & ranking engine, a camera-capture revamp, and 40+ tickets into a near-weekly release cadence.',
  },
  {
    company: 'EaseAccess24',
    role: 'Software Engineering Intern',
    period: 'June 2026 - Present',
    summary: 'Building developer productivity and AI workflow tooling, including CLI flows that make staging and production environment switches less fragile.',
  },
  {
    company: 'Cleanr + StreamScope',
    role: 'Startup product builds',
    period: '2025 - 2026',
    summary: 'Led Cleanr mobile product execution and helped ship StreamScope from zero in 10 days, earning 2nd place at IE Tech Venture Bootcamp 2026.',
  },
];

const experience = [
  {
    company: 'naiss ride',
    role: 'Mobile Software Engineer',
    period: 'June 2026 - Present',
    location: 'Remote',
    summary: 'Shipping production features for a live social-carpooling app on iOS & Android (4.6/5 App Store): rewards & ranking engine, camera-capture revamp, and an XP system, with 40+ tickets on a near-weekly release cadence.',
    current: true,
  },
  {
    company: 'EaseAccess24',
    role: 'Software Engineering Intern',
    period: 'June 2026 - Present',
    location: 'Skopje, North Macedonia (on-site)',
    summary: 'Building developer productivity and AI workflow tools that reduce fragile setup and make engineering context switches faster.',
    current: true,
  },
  {
    company: 'IE Tech Lab - Bloomberg Project',
    role: 'Tech Lab Student Collaborator',
    period: 'January 2026 - June 2026',
    location: 'Madrid, Spain',
    summary: 'Built a Bloomberg-sponsored ESG Trust Score product and a simplified Bloomberg Terminal prototype ("Tape") as an IE Tech Lab company-sponsored project.',
  },
  {
    company: 'Cleanr',
    role: 'Tech Lead & Full-Stack Developer',
    period: 'March 2025 - April 2026',
    location: 'Madrid, Spain',
    summary: 'Led a three-developer team building a dual-sided apartment-cleaning marketplace with React Native, Expo, Firebase, Stripe, and Google Maps.',
  },
  {
    company: 'Kanamoh Solutions',
    role: 'Front-End Developer',
    period: 'April 2025 - June 2025',
    summary: 'Built React front-end surfaces for an AI-powered 3D printing platform and helped integrate LLM-driven natural-language workflows.',
  },
  {
    company: 'IE Tech Lab - Ferrero Project',
    role: 'Tech Lab Student Collaborator',
    period: 'January 2025 - June 2025',
    location: 'Madrid, Spain',
    summary: 'Built an AI cost-prediction and digital-twin system for Ferrero (Kinder) as an IE Tech Lab company-sponsored project.',
  },
  {
    company: 'IE Robotics & AI Club',
    role: 'Developer',
    period: 'January 2025 - May 2025',
    location: 'Madrid, Spain',
    summary: 'Rebuilt chess in Python and Pygame and implemented a rule-based chess engine with the IE Robotics & AI Club.',
  },
  {
    company: 'Boston University',
    role: 'Summer Student - CS & Creative Writing',
    period: 'June 2023 - July 2023',
    location: 'Boston, MA',
    summary: 'Completed intensive coursework in Python and creative writing, strengthening both technical problem-solving and communication.',
  },
  {
    company: 'MACEF - Macedonian Center for Energy Efficiency',
    role: 'Intern',
    period: 'July 2022 - August 2022',
    location: 'North Macedonia',
    summary: 'Worked on renewable energy and energy-efficiency initiatives, including photovoltaic system performance and panel-orientation optimization.',
  },
  {
    company: 'Accent On Computers LLC',
    role: 'IT Intern - Software & Hardware',
    period: 'June 2022 - August 2022',
    summary: 'Assisted with software setup, troubleshooting, system configuration, PC diagnostics, repairs, and component replacement.',
  },
  {
    company: 'Texas A&M University at Qatar',
    role: 'Non-Affiliated Student Assistant',
    period: 'Oct 2021 - Apr 2022',
    location: 'Doha, Qatar',
    summary: 'Supported Python projects and client engagement and contributed to a 10% increase in departmental sales conversions, developing early technical-support and communication habits.',
  },
];

const beyondCode = [
  { label: 'Basketball', detail: 'Training since second grade', icon: Trophy, color: 'text-orange-400' },
  { label: 'Running', detail: 'Half-marathons and 10km races', icon: Dumbbell, color: 'text-green-400' },
  { label: 'Reading', detail: 'Avid book reader', icon: BookOpen, color: 'text-blue-400' },
  { label: 'Cello', detail: '6 years with live performances', icon: Music, color: 'text-purple-400' },
];
---

<section id="about" class="py-24" aria-labelledby="about-heading">
  <div class="about-reveal mb-14 grid gap-6 lg:grid-cols-[0.72fr_1fr] lg:items-end">
    <div>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-blue-accent/80">About me</p>
      <h2 id="about-heading" class="text-4xl font-extrabold tracking-tight text-white md:text-5xl">The fuller story.</h2>
    </div>
    <p class="max-w-3xl text-base leading-relaxed text-white/60 lg:justify-self-end">
      I&apos;m a Computer Science & Artificial Intelligence student at IE University in Madrid, expected to graduate in May 2028. I build mobile products, AI workflows, startup MVPs, games, and technical experiments with a bias toward useful systems, fast learning, and work that survives outside a demo.
    </p>
  </div>

  <div class="space-y-16">
    <section aria-labelledby="current-work-heading" class="about-reveal rounded-3xl border border-white/10 bg-premium-gray/55 p-6 md:p-8">
      <div class="mb-7 flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-blue-accent/25 bg-blue-accent/10 text-blue-accent">
          <Briefcase className="h-5 w-5" />
        </div>
        <div>
          <h3 id="current-work-heading" class="text-2xl font-bold text-white">What I&apos;m building now</h3>
          <p class="text-sm text-white/50">Current work across startup products, internal tools, and shipped experiments.</p>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        {currentWork.map((item) => (
          <article class="about-card-reveal rounded-2xl border border-white/10 bg-white/[0.035] p-5 transition duration-300 hover:border-blue-accent/35 hover:bg-blue-accent/10">
            <p class="text-xs uppercase tracking-[0.2em] text-blue-accent/70">{item.period}</p>
            <h4 class="mt-3 text-lg font-semibold text-white">{item.role}</h4>
            <p class="mt-1 text-sm text-white/50">{item.company}</p>
            <p class="mt-4 text-sm leading-relaxed text-white/60">{item.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="timeline-heading" class="about-reveal">
      <div class="history-heading mb-8 flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-blue-accent/25 bg-blue-accent/10 text-blue-accent">
          <Target className="h-5 w-5" />
        </div>
        <div>
          <h3 id="timeline-heading" class="text-2xl font-bold text-white">Proof over time</h3>
          <p class="text-sm text-white/50">The path from early technical support to live product engineering.</p>
        </div>
      </div>

      <ol class="timeline space-y-7">
        {experience.map((item, index) => (
          <li class="timeline-item relative pl-12">
            {index < experience.length - 1 && (
              <span class="timeline-line absolute left-[15px] top-[42px] bottom-[-28px] w-px origin-top bg-gradient-to-b from-blue-accent/40 to-blue-accent/0" aria-hidden="true"></span>
            )}
            <div class="timeline-node absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-xl border border-blue-accent/30 bg-blue-accent/10 text-xs font-bold text-blue-accent">
              {item.company.split(' ')[0].slice(0, 2).toUpperCase()}
            </div>
            <article class="timeline-content border-b border-white/10 pb-7">
              <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h4 class="text-lg font-semibold text-white">{item.role}</h4>
                    {item.current && (
                      <span class="rounded-full border border-green-500/30 bg-green-500/10 px-2 py-0.5 text-xs text-green-400">Current</span>
                    )}
                  </div>
                  <p class="mt-1 text-sm text-white/50">{item.company}</p>
                </div>
                <p class="text-sm text-white/45 md:text-right">
                  {item.period}{item.location ? ` - ${item.location}` : ''}
                </p>
              </div>
              <p class="mt-4 max-w-4xl text-sm leading-relaxed text-white/60">{item.summary}</p>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="about-reveal rounded-3xl border border-white/10 bg-premium-gray/55 p-6 md:p-8">
        <div class="mb-6 flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-blue-accent/25 bg-blue-accent/10 text-blue-accent">
            <Target className="h-5 w-5" />
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white">Beyond Code</h3>
            <p class="text-sm text-white/50">The habits that keep the work sharp.</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {beyondCode.map((item) => {
            const Icon = item.icon;
            return (
              <div class="about-card-reveal rounded-2xl border border-white/10 bg-white/[0.035] p-4">
                <Icon className={`mb-3 h-6 w-6 ${item.color}`} />
                <h4 class="text-sm font-semibold text-white">{item.label}</h4>
                <p class="mt-1 text-xs leading-relaxed text-white/50">{item.detail}</p>
              </div>
            );
          })}
        </div>

        <div class="about-card-reveal mt-5 rounded-2xl border border-blue-accent/20 bg-blue-accent/5 p-4">
          <h4 class="mb-2 text-sm font-semibold text-blue-accent">Volunteer Work</h4>
          <ul class="space-y-1 text-xs leading-relaxed text-white/60">
            <li>FIFA World Cup Qatar 2022: flag bearer</li>
            <li>Skateboard ramp renovation project leader</li>
            <li>Olkoroi Wilderness Camp community volunteer in Kenya</li>
          </ul>
        </div>
      </div>

      <div class="about-reveal rounded-3xl border border-white/10 bg-premium-gray/55 p-6 md:p-8">
        <div class="mb-6 flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-blue-accent/25 bg-blue-accent/10 text-blue-accent">
            <GraduationCap className="h-5 w-5" />
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white">Education</h3>
            <p class="text-sm text-white/50">The foundation behind the product and systems work.</p>
          </div>
        </div>

        <div class="space-y-6">
          <article class="about-card-reveal">
            <div class="flex flex-wrap items-center gap-2">
              <h4 class="text-lg font-semibold text-white">Bachelor&apos;s in Computer Science & AI</h4>
              <span class="rounded-full border border-green-500/30 bg-green-500/10 px-2 py-0.5 text-xs text-green-400">Current</span>
            </div>
            <p class="mt-1 text-sm text-white/50">IE University, Madrid - 2024 to 2028 expected</p>
            <p class="mt-3 text-sm leading-relaxed text-white/60">
              Focused on software engineering, machine learning, algorithms, and product-oriented technical execution. ML final project: behavioral anomaly detection in online chess, 100/100.
            </p>
          </article>

          <article class="about-card-reveal border-t border-white/10 pt-6">
            <h4 class="text-lg font-semibold text-white">International Baccalaureate Diploma</h4>
            <p class="mt-1 text-sm text-white/50">SEK International School, Doha, Qatar - 2018 to 2024</p>
            <p class="mt-3 text-sm leading-relaxed text-white/60">
              Completed the IB Diploma with Higher Level Mathematics and Physics (predicted 38/45), building the analytical base behind my current CS and AI work.
            </p>
          </article>

          <div class="about-card-reveal border-t border-white/10 pt-6">
            <h4 class="mb-3 text-xs uppercase tracking-[0.22em] text-white/50">Certifications & Signals</h4>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/60">AWS Educate Compute - Oct 2025</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/60">Machine Learning Final - 100/100</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-white/60">IE Tech Venture Bootcamp - 2nd Place</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</section>

<style>
  .timeline-line {
    transform: scaleY(1);
  }
</style>
