---
import { Code2, Briefcase, Target, Trophy, Dumbbell, BookOpen, Music, GraduationCap } from 'lucide-react';
// About section with info from CV
---

<section id="about" class="py-24">
  <div class="mb-16">
    <h2 class="text-4xl md:text-5xl font-bold mb-4">About Me</h2>
    <div class="h-1 w-20 bg-blue-accent rounded-full"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Bio Card -->
    <div class="group relative overflow-hidden rounded-3xl bg-premium-gray border border-white/5 p-8 transition-all duration-500 hover:border-blue-accent/40">
      <!-- Gradient overlay on hover -->
      <div class="gradient-overlay absolute inset-0 bg-gradient-to-br from-blue-accent/0 to-blue-accent/10 opacity-0 transition-opacity duration-700"></div>
      
      <!-- Border glow effect -->
      <div class="border-glow absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500" style="box-shadow: 0 0 50px rgba(59, 130, 246, 0.2);"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-6">
          <Code2 className="w-7 h-7 text-blue-accent" />
          <h3 class="text-2xl font-bold group-hover:text-blue-accent transition-colors duration-300">Bio</h3>
        </div>
        
	        <p class="text-white/70 leading-relaxed mb-4">
	          I'm a Computer Science & Artificial Intelligence student at <span class="text-blue-accent font-medium">IE University in Madrid</span>, currently pursuing my Bachelor's degree with an expected graduation in May 2028. I build <span class="text-blue-accent font-medium">production mobile systems, AI automation, and fast-shipped product experiments</span>.
	        </p>
	        
	        <p class="text-white/70 leading-relaxed mb-4">
	          Right now I work across startup mobile engineering at <span class="text-blue-accent font-medium">Naiss Ride Company</span> and developer productivity / AI automation at <span class="text-blue-accent font-medium">EaseAccess24</span>. I care about the full loop: finding a real user problem, shipping the smallest credible product, instrumenting it, and tightening the system until it holds up.
	        </p>

        <p class="text-white/70 leading-relaxed">
          I speak <span class="text-white font-medium">Macedonian</span> and <span class="text-white font-medium">English</span> natively, with <span class="text-white font-medium">professional working proficiency in Spanish</span>.
        </p>
      </div>
    </div>

    <!-- Experience Card -->
    <div class="group relative overflow-hidden rounded-3xl bg-premium-gray border border-white/5 p-8 transition-all duration-500 hover:border-blue-accent/40">
      <div class="gradient-overlay absolute inset-0 bg-gradient-to-br from-blue-accent/0 to-blue-accent/10 opacity-0 transition-opacity duration-700"></div>
      <div class="border-glow absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500" style="box-shadow: 0 0 50px rgba(59, 130, 246, 0.2);"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-6">
          <Briefcase className="w-7 h-7 text-blue-accent" />
          <h3 class="text-2xl font-bold group-hover:text-blue-accent transition-colors duration-300">Experience</h3>
        </div>

        <div class="max-h-[400px] overflow-y-auto experience-scroll pr-2 space-y-6" data-lenis-prevent>
	          <!-- Experience Item 1: Naiss - Current -->
	          <div class="experience-item">
	            <div class="flex items-start gap-3 mb-2">
	              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-accent/20 border border-blue-accent/40 text-sm font-bold mt-1">
	                <span class="text-blue-accent">N</span>
	              </div>
	              <div class="flex-1">
	                <div class="flex items-center gap-2 mb-1">
	                  <h4 class="font-semibold text-white">Mobile Software Engineer</h4>
	                  <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400 border border-green-500/30">Current</span>
	                </div>
	                <p class="text-sm text-white/50">Naiss Ride Company</p>
	                <p class="text-xs text-white/40 mt-1">June 2026 - Present • Madrid, Spain</p>
	              </div>
	            </div>
	            <p class="text-sm text-white/60 ml-11">
	              Engineering production features across ride flows, feed, camera, gamification, auth, and payments in a live React Native / Expo / TypeScript app. Improving reliability and product visibility through Sentry, PostHog, Jest, Detox, and EAS release workflows.
	            </p>
	          </div>

	          <!-- Experience Item 2: EaseAccess24 - Current -->
	          <div class="experience-item">
	            <div class="flex items-start gap-3 mb-2">
	              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-bold mt-1">
	                EA
	              </div>
	              <div class="flex-1">
	                <div class="flex items-center gap-2 mb-1">
	                  <h4 class="font-semibold text-white">Software Engineering Intern</h4>
	                  <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400 border border-green-500/30">Current</span>
	                </div>
	                <p class="text-sm text-white/50">EaseAccess24</p>
	                <p class="text-xs text-white/40 mt-1">June 2026 - Present • Remote</p>
	              </div>
	            </div>
	            <p class="text-sm text-white/60 ml-11">
	              Building developer productivity and AI automation tooling, including CLI workflows for staging and production environment switching with Vercel and Psono integrations. Focused on reducing fragile manual setup and speeding up engineering context switches.
	            </p>
	          </div>

	          <!-- Experience Item 3: Cleanr -->
	          <div class="experience-item">
	            <div class="flex items-start gap-3 mb-2">
	              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-orange-500/10 text-orange-400 text-sm font-bold mt-1">
	                C
	              </div>
	              <div class="flex-1">
	                <div class="flex items-center gap-2 mb-1">
	                  <h4 class="font-semibold text-white">Tech Lead & Full-Stack Developer</h4>
	                </div>
	                <p class="text-sm text-white/50">Cleanr</p>
	                <p class="text-xs text-white/40 mt-1">March 2025 - April 2026 • Madrid, Spain</p>
	              </div>
	            </div>
	            <p class="text-sm text-white/60 ml-11">
	              Led a three-developer team building an Uber-like apartment-cleaning marketplace with React Native, Expo, TypeScript, Firebase, Stripe, and Google Maps. Architected booking, cleaner matching, scheduled and on-demand flows, cancellation logic, and mobile release execution.
	            </p>
	          </div>

          <!-- Experience Item 4: Kanamoh Solutions -->
          <div class="experience-item">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 text-sm font-bold mt-1">
                K
              </div>
              <div class="flex-1">
                <h4 class="font-semibold text-white">Front-End Developer</h4>
                <p class="text-sm text-white/50">Kanamoh Solutions</p>
                <p class="text-xs text-white/40 mt-1">April 2025 - June 2025</p>
              </div>
            </div>
            <p class="text-sm text-white/60 ml-11">
              Built a clean and intuitive React front-end for an AI-powered 3D printing platform. Collaborated with backend engineers to integrate LLM-driven natural language workflows. Helped translate text prompts into sliceable, 3D-print-ready models. Improved usability and accessibility of advanced CAD functionality for non-technical users.
            </p>
          </div>

          <!-- Experience Item 5: Boston University -->
          <div class="experience-item">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-red-500/10 text-red-400 text-sm font-bold mt-1">
                BU
              </div>
              <div class="flex-1">
                <h4 class="font-semibold text-white">Summer Student – CS & Creative Writing</h4>
                <p class="text-sm text-white/50">Boston University</p>
                <p class="text-xs text-white/40 mt-1">June 2023 - July 2023 • Boston, MA</p>
              </div>
            </div>
            <p class="text-sm text-white/60 ml-11">
              Completed an intensive summer program including coursework in Computer Science (Python) and Creative Writing. Developed foundational programming skills through hands-on Python exercises and small projects, strengthening logical thinking and problem-solving abilities. Complemented technical learning with creative writing seminars, enhancing communication skills and structured thinking.
            </p>
          </div>

          <!-- Experience Item 6: MACEF -->
          <div class="experience-item">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-green-500/10 text-green-400 text-sm font-bold mt-1">
                M
              </div>
              <div class="flex-1">
                <h4 class="font-semibold text-white">Intern</h4>
                <p class="text-sm text-white/50">MACEF - Macedonian Center for Energy Efficiency</p>
                <p class="text-xs text-white/40 mt-1">July 2022 - August 2022 • North Macedonia</p>
              </div>
            </div>
            <p class="text-sm text-white/60 ml-11">
              Worked on renewable energy and energy efficiency initiatives with a focus on solar panel systems. Gained hands-on exposure to how photovoltaic systems operate, including performance factors and efficiency constraints. Assisted in analyzing optimization methods such as panel orientation and rotational adjustments to maximize energy output.
            </p>
          </div>

          <!-- Experience Item 7: Accent On Computers -->
          <div class="experience-item">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-bold mt-1">
                A
              </div>
              <div class="flex-1">
                <h4 class="font-semibold text-white">IT Intern – Software & Hardware</h4>
                <p class="text-sm text-white/50">Accent On Computers LLC</p>
                <p class="text-xs text-white/40 mt-1">June 2022 - August 2022</p>
              </div>
            </div>
            <p class="text-sm text-white/60 ml-11">
              Assisted with basic software setup, troubleshooting, and system configuration for small and medium business clients. Shadowed a hardware engineer during PC diagnostics, repairs, and component replacement. Gained early hands-on exposure to IT support workflows, customer interaction, and technical problem-solving.
            </p>
          </div>

          <!-- Experience Item 8: Texas A&M -->
          <div class="experience-item">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-yellow-500/10 text-yellow-400 text-sm font-bold mt-1">
                T
              </div>
              <div class="flex-1">
                <h4 class="font-semibold text-white">Non-Affiliated Student Assistant</h4>
                <p class="text-sm text-white/50">Texas A&M University at Qatar</p>
                <p class="text-xs text-white/40 mt-1">Oct 2021 - Apr 2022 • Doha, Qatar</p>
              </div>
            </div>
            <p class="text-sm text-white/60 ml-11">
              Supported Python programming projects, including game logic and utility applications. Assisted clients and contributed to a 10% increase in sales through improved engagement. Developed organizational and communication skills while managing front-desk operations.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Interests Card -->
    <div class="group relative overflow-hidden rounded-3xl bg-premium-gray border border-white/5 p-8 transition-all duration-500 hover:border-blue-accent/40">
      <div class="gradient-overlay absolute inset-0 bg-gradient-to-br from-blue-accent/0 to-blue-accent/10 opacity-0 transition-opacity duration-700"></div>
      <div class="border-glow absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500" style="box-shadow: 0 0 50px rgba(59, 130, 246, 0.2);"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-6">
          <Target className="w-7 h-7 text-blue-accent" />
          <h3 class="text-2xl font-bold group-hover:text-blue-accent transition-colors duration-300">Beyond Code</h3>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="interest-card group/interest p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-accent/30 transition-all duration-300">
            <Trophy className="w-6 h-6 mb-2 text-orange-400" />
            <h4 class="font-semibold text-sm mb-1 group-hover/interest:text-blue-accent transition-colors duration-300">Basketball</h4>
            <p class="text-xs text-white/50">Training since second grade</p>
          </div>

          <div class="interest-card group/interest p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-accent/30 transition-all duration-300">
            <Dumbbell className="w-6 h-6 mb-2 text-green-400" />
            <h4 class="font-semibold text-sm mb-1 group-hover/interest:text-blue-accent transition-colors duration-300">Running</h4>
            <p class="text-xs text-white/50">Half-marathons, 10km races</p>
          </div>

          <div class="interest-card group/interest p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-accent/30 transition-all duration-300">
            <BookOpen className="w-6 h-6 mb-2 text-blue-400" />
            <h4 class="font-semibold text-sm mb-1 group-hover/interest:text-blue-accent transition-colors duration-300">Reading</h4>
            <p class="text-xs text-white/50">Avid book reader</p>
          </div>

          <div class="interest-card group/interest p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-accent/30 transition-all duration-300">
            <Music className="w-6 h-6 mb-2 text-purple-400" />
            <h4 class="font-semibold text-sm mb-1 group-hover/interest:text-blue-accent transition-colors duration-300">Cello</h4>
            <p class="text-xs text-white/50">6 years, live performances</p>
          </div>
        </div>

        <div class="mt-6 p-4 rounded-2xl bg-blue-accent/5 border border-blue-accent/20">
          <h4 class="font-semibold text-sm mb-2 text-blue-accent">Volunteer Work</h4>
          <ul class="text-xs text-white/60 space-y-1">
	            <li>• FIFA World Cup Qatar 2022: Flag bearer</li>
            <li>• Skateboard ramp renovation project leader</li>
            <li>• Olkoroi Wilderness Camp community volunteer (Kenya)</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Education Card -->
    <div class="group relative overflow-hidden rounded-3xl bg-premium-gray border border-white/5 p-8 transition-all duration-500 hover:border-blue-accent/40">
      <div class="gradient-overlay absolute inset-0 bg-gradient-to-br from-blue-accent/0 to-blue-accent/10 opacity-0 transition-opacity duration-700"></div>
      <div class="border-glow absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500" style="box-shadow: 0 0 50px rgba(59, 130, 246, 0.2);"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-6">
          <GraduationCap className="w-7 h-7 text-blue-accent" />
          <h3 class="text-2xl font-bold group-hover:text-blue-accent transition-colors duration-300">Education</h3>
        </div>

        <div class="space-y-6">
          <!-- Current Education -->
          <div class="education-item relative">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center min-w-8 w-8 h-8 rounded-lg bg-blue-accent/20 border border-blue-accent/40 text-sm font-bold mt-1">
                <span class="text-blue-accent">IE</span>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <h4 class="font-semibold text-white">Bachelor's in Computer Science & AI</h4>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400 border border-green-500/30">Current</span>
                </div>
                <p class="text-sm text-white/50">IE University, Madrid</p>
                <p class="text-xs text-white/40 mt-1">2024 - 2028 (Expected)</p>
              </div>
            </div>
	            <p class="text-sm text-white/60 ml-11">
	              Pursuing Computer Science and Artificial Intelligence with strong focus on software engineering, machine learning, algorithms, and product-oriented technical execution. ML final project: chess behavioral anomaly detection, 100/100.
            </p>
          </div>

          <!-- IB Education -->
          <div class="education-item relative">
            <div class="flex items-start gap-3 mb-2">
              <div class="flex items-center justify-center min-w-8 w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-bold mt-1">
                IB
              </div>
              <div class="flex-1">
                <h4 class="font-semibold text-white">International Baccalaureate Diploma</h4>
                <p class="text-sm text-white/50">SEK International School, Qatar</p>
                <p class="text-xs text-white/40 mt-1">2022 - 2024</p>
              </div>
            </div>
	            <p class="text-sm text-white/60 ml-11">
	              Completed rigorous IB curriculum with Higher Level Mathematics and Physics, developing the analytical base behind my current CS and AI work.
            </p>
          </div>
        </div>

        <!-- Certifications -->
        <div class="mt-6 pt-6 border-t border-white/5">
          <h4 class="text-xs uppercase tracking-widest text-white/50 mb-3">Certifications & Courses</h4>
          <div class="flex flex-wrap gap-2">
	            <span class="text-xs px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/60 hover:border-blue-accent/30 hover:text-blue-accent transition-colors duration-300">AWS Educate Compute - Oct 2025</span>
	            <span class="text-xs px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/60 hover:border-blue-accent/30 hover:text-blue-accent transition-colors duration-300">Machine Learning Final - 100/100</span>
	            <span class="text-xs px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/60 hover:border-blue-accent/30 hover:text-blue-accent transition-colors duration-300">IE Tech Venture Bootcamp - 2nd Place</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gradient-overlay,
  .border-glow {
    transition: opacity 0.5s ease;
  }

  .group:hover .gradient-overlay {
    opacity: 1;
  }

  .group:hover .border-glow {
    opacity: 1;
  }

  .experience-item {
    position: relative;
    padding-left: 0;
  }

  .experience-item::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 45px;
    bottom: -20px;
    width: 1px;
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.3), transparent);
  }

  .experience-item:last-child::before {
    display: none;
  }

  /* Education timeline connector */
  .education-item {
    position: relative;
    padding-left: 0;
    margin-bottom: 2rem;
  }

  .education-item::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 45px;
    bottom: -20px;
    width: 1px;
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.3), transparent);
  }

  .education-item:last-child::before {
    display: none;
  }

  /* Custom scrollbar for experience section */
  .experience-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .experience-scroll::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
  }

  .experience-scroll::-webkit-scrollbar-thumb {
    background: rgba(59, 130, 246, 0.3);
    border-radius: 10px;
    transition: background 0.3s ease;
  }

  .experience-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(59, 130, 246, 0.5);
  }

  /* Smooth scroll behavior */
  .experience-scroll {
    scroll-behavior: smooth;
  }
</style>
