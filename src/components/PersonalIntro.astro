---
import { Dumbbell, MapPin, Rocket, Sparkles } from 'lucide-react';

const signals = [
  {
    label: 'Builder',
    detail: 'I like turning rough ideas into working products quickly.',
    icon: Sparkles,
  },
  {
    label: 'Madrid / IE',
    detail: 'CS & AI student at IE University, building from Madrid.',
    icon: MapPin,
  },
  {
    label: 'Startup energy',
    detail: 'Currently moving between mobile systems, tooling, and automation.',
    icon: Rocket,
  },
  {
    label: 'Basketball + running',
    detail: 'Training, races, and staying competitive outside the editor.',
    icon: Dumbbell,
  },
];
---

<section id="meet" class="py-12 md:py-16" aria-labelledby="meet-heading">
  <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-premium-gray/60 p-5 md:p-7 lg:p-8">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_0%,rgba(59,130,246,0.16),transparent_34%)] pointer-events-none"></div>
    <div class="relative z-10 grid gap-6 md:grid-cols-[0.42fr_0.58fr] lg:gap-10 items-center">
      <div class="relative h-[300px] overflow-hidden rounded-2xl border border-white/10 bg-premium-black md:h-[390px]">
        <img
          src="/assets/about/kiril-matura.jpg"
          alt="Kiril Petrovski"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[42%_40%]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-premium-black/45 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-4">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-premium-black/55 px-3.5 py-2 text-[11px] uppercase tracking-[0.22em] text-white/70 backdrop-blur-md">
            <span class="h-2 w-2 rounded-full bg-blue-accent"></span>
            Madrid-based builder
          </div>
        </div>
      </div>

      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-blue-accent/80">Before the work</p>
        <h2 id="meet-heading" class="mb-4 text-3xl font-extrabold tracking-tight text-white md:text-4xl">
          Hey, I&apos;m Kiril.
        </h2>
        <p class="max-w-2xl text-base leading-relaxed text-white/70 md:text-lg">
          I&apos;m a CS & AI student in Madrid building startup mobile products, AI automation, games, and technical experiments. I like the full loop: find a real problem, ship something usable, learn from it, and tighten the system.
        </p>

        <div class="mt-7 grid gap-3 sm:grid-cols-2">
          {signals.map((signal) => {
            const Icon = signal.icon;
            return (
              <div class="intro-signal flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.035] p-3.5 transition duration-300 hover:border-blue-accent/35 hover:bg-blue-accent/10">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-blue-accent/25 bg-blue-accent/10 text-blue-accent">
                  <Icon className="h-4 w-4" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-white">{signal.label}</h3>
                  <p class="mt-1 text-xs leading-relaxed text-white/50">{signal.detail}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
