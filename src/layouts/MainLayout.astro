---
import '../styles/global.css';
import '@fontsource-variable/inter';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Kiril-P // Software Engineer Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-premium-black">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Kiril Petrovski" />
		<meta name="keywords" content="Kiril Petrovski, Mobile Software Engineer, CS AI Student, Product Builder, React Native, TypeScript, Python, Machine Learning, Startup Engineer, Game Development, Portfolio" />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://kpetrovski.me/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Kiril Petrovski - Software Engineer" />
		<!-- Add og:image once you have a preview image -->
		<!-- <meta property="og:image" content="https://kpetrovski.me/og-image.png" /> -->
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://kpetrovski.me/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<!-- Add twitter:image once you have a preview image -->
		<!-- <meta property="twitter:image" content="https://kpetrovski.me/og-image.png" /> -->
		
		<!-- Canonical URL -->
		<link rel="canonical" href="https://kpetrovski.me/" />
		
		<!-- Theme Color -->
		<meta name="theme-color" content="#050505" />

		<!-- Privacy-friendly analytics by Plausible -->
		<script is:inline async src="https://plausible.io/js/pa-tbOEvswPuTsG0DD7WPc6K.js"></script>
		<script is:inline>
			window.plausible = window.plausible || function () {
				(plausible.q = plausible.q || []).push(arguments);
			};
			plausible.init = plausible.init || function (i) {
				plausible.o = i || {};
			};
			plausible.init();
		</script>
		
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Kiril Petrovski",
				"jobTitle": "Mobile Software Engineer & Product Builder",
				"description": "Computer Science & AI student building mobile products, AI workflows, startup MVPs, ML systems, and interactive software",
				"url": "https://kpetrovski.me",
				"sameAs": [
					"https://github.com/kiril-p",
					"https://linkedin.com/in/kiril-petrovski",
					"https://kirilp.itch.io",
					"https://x.com/pl1rik"
				],
				"knowsAbout": [
					"Mobile Software Engineering",
					"AI Automation",
					"Startup Product Engineering",
					"TypeScript",
					"React",
					"React Native",
					"Expo",
					"Python",
					"Machine Learning",
					"Artificial Intelligence",
					"Game Development"
				],
				"alumniOf": {
					"@type": "EducationalOrganization",
					"name": "IE University",
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Madrid",
						"addressCountry": "Spain"
					}
				},
				"email": "kirilpetrovski2005@gmail.com",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Madrid",
					"addressCountry": "Spain"
				}
			}
		</script>
	</head>
	<body class="selection:bg-accent selection:text-premium-black">
		<slot />
	</body>
</html>

<script>
	import Lenis from 'lenis';
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	// Register GSAP plugins
	gsap.registerPlugin(ScrollTrigger);

	// Initialize Lenis smooth scrolling
	const lenis = new Lenis({
		duration: 0.7, // Further reduced for a more native feel
		easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
		orientation: 'vertical',
		gestureOrientation: 'vertical',
		smoothWheel: true,
		wheelMultiplier: 0.9, // Lower multiplier reduces the "travel" distance per scroll
		touchMultiplier: 3.0,
		infinite: false,
	});

	// Integrate Lenis with GSAP ScrollTrigger
	lenis.on('scroll', ScrollTrigger.update);

	// Use GSAP ticker for smooth integration
	gsap.ticker.add((time) => {
		lenis.raf(time * 1000);
	});

	// Disable lag smoothing for better performance
	gsap.ticker.lagSmoothing(0);

	// Keep Lenis and ScrollTrigger synchronized through the listener above.
</script>

<style is:global>
	:root {
		--accent: 255, 255, 255;
	}
	html {
		font-family: 'Inter Variable', 'Inter', system-ui, sans-serif;
		/* Removed scroll-behavior: smooth - Lenis handles this now */
	}
	html.lenis {
		height: auto;
	}
	.lenis.lenis-smooth {
		scroll-behavior: auto;
	}
	.lenis.lenis-smooth [data-lenis-prevent] {
		overscroll-behavior: contain;
	}
	.lenis.lenis-stopped {
		overflow: hidden;
	}
	.lenis.lenis-scrolling iframe {
		pointer-events: none;
	}
</style>
